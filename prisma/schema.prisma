// SchoolLens data model
// See README "Data Model" section for design notes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  id          String    @id @default(cuid())
  name        String
  arabicName  String?
  slug        String    @unique
  location    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]

  @@index([slug])
}

model Comment {
  id          String    @id @default(cuid())
  externalId  String
  source      String
  schoolId    String
  text        String
  topic       String
  sentiment   String
  publishedAt DateTime
  createdAt   DateTime  @default(now())
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // source + externalId must be unique together so re-sending the same
  // Facebook comment from Hermes does not create duplicates.
  @@unique([source, externalId])
  @@index([schoolId])
  @@index([schoolId, topic])
  @@index([schoolId, sentiment])
}